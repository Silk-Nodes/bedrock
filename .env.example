# Bedrock web · environment
#
# The only variable the app needs. Point it at a Bedrock indexer's HTTP API.
# Defaults to http://127.0.0.1:8080 when unset (see lib/indexer.ts), so local
# dev works without this file if you run an indexer on the default port.
#
# Pages that need live data degrade to their "accruing" empty state when the
# indexer is unreachable. They do not crash and they never show mock numbers.
BEDROCK_INDEXER_URL=http://127.0.0.1:8080
